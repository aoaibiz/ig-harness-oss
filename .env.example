# ===========================================
# Instagram Harness - Environment Variables
# ===========================================
# For Worker: set via `wrangler secret put <NAME>`
# For Web: copy to apps/web/.env.local

# --- Worker (Cloudflare Workers) ---
# Set these with: wrangler secret put <NAME>
API_KEY=your-api-key
IG_ACCESS_TOKEN=your-instagram-access-token
IG_APP_SECRET=your-instagram-app-secret
IG_USER_ID=your-instagram-user-id
IG_VERIFY_TOKEN=your-webhook-verify-token
WORKER_URL=https://your-worker.workers.dev
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --- Auto-send safety (READ BEFORE ENABLING — see README "Safety" section) ---
# Master kill-switch for ALL automated DM sending (comment rules, engagement
# gates, followup drip, scenarios, broadcasts, form acks).
#
#   FAIL-CLOSED DEFAULT: automations are OFF unless this is EXACTLY '1'.
#   Unset, empty, '0', 'true', or anything else = NO automated send.
#   A fresh deploy that never sets this variable sends NOTHING automatically.
#
# Only set to '1' after you have read Meta's Instagram messaging policy and
# the README Safety section. Set it as a Worker variable, e.g. add it under
# [vars] in apps/worker/wrangler.toml or `wrangler deploy --var AUTO_DM_ENABLED:1`.
AUTO_DM_ENABLED=
# Outbound caps (optional; positive integers). Unset/invalid values fall back
# to conservative defaults chosen well below Meta's technical ceilings:
#   100 sends/account/rolling hour, 300 sends/account/rolling 24h,
#   5 sends/recipient/rolling 24h.
AUTO_DM_HOURLY_CAP=
AUTO_DM_DAILY_CAP=
AUTO_DM_RECIPIENT_DAILY_CAP=

# Required only when exposing the optional LINE bridge routes.
LINE_LIFF_ID=your-own-liff-id
LINE_ADD_URL=https://your-line-worker.workers.dev/auth/line

# --- Web App (Next.js Admin Dashboard) ---
# Copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=https://your-worker.workers.dev

# --- MCP Server ---
# Set in your MCP client config
IG_HARNESS_API_URL=https://your-worker.workers.dev
IG_HARNESS_API_KEY=your-api-key
